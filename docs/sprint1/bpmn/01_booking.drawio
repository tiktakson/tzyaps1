  <diagram name="Сторінка-1" id="xdl-zO458X8eSXf34MK7">
    <mxGraphModel dx="2005" dy="1820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
